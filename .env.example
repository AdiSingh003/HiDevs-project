# ---------------------------------------------------------------------------------------------
# Copy to .env and fill in. Everything is optional: without Lyzr keys the platform runs fully
# offline (deterministic policy engine + template voices + local Safe AI rules + local ledger).
# ---------------------------------------------------------------------------------------------

# --- Lyzr Agent API (https://studio.lyzr.ai -> Account -> API keys) -----------------------------
LYZR_API_KEY=
LYZR_USER_ID=you@example.com
LYZR_AGENT_BASE_URL=https://agent-prod.studio.lyzr.ai
LYZR_RAI_BASE_URL=https://rai-prod.studio.lyzr.ai
LYZR_TIMEOUT_S=45
LYZR_MAX_RETRIES=2

# Model used when provisioning agents (python -m agents.lyzr.provision)
LYZR_PROVIDER_ID=OpenAI
LYZR_MODEL=gpt-4o-mini
LYZR_LLM_CREDENTIAL_ID=lyzr_openai

# --- Agent IDs (printed by `python -m agents.lyzr.provision`) ----------------------------------
LYZR_BUYER_AGENT_ID=
LYZR_SUPPLIER_AGENT_ID=
LYZR_DRAFTER_AGENT_ID=
LYZR_REVIEWER_AGENT_ID=
LYZR_SUMMARY_AGENT_ID=
LYZR_AUDIT_AGENT_ID=

# --- Lyzr Safe AI (RAI + OPA) ------------------------------------------------------------------
# Shared policy plus per-party policies (each negotiator's guardrail knows only its own leak rules)
LYZR_RAI_POLICY_ID=
LYZR_RAI_BUYER_POLICY_ID=
LYZR_RAI_SUPPLIER_POLICY_ID=
# OPA guardrails are compiled from each sealed envelope and registered by content hash
# (provision pre-registers every preset; new envelopes are registered on first use)
LYZR_OPA_GUARDRAILS=true

# --- Lyzr AIMS audit mirroring: local | event_log | agent_session ---------------------------------
# event_log: every entry -> POST /log/{session}; chain-head anchors go to the audit-scribe agent session
AIMS_MODE=local

# --- Backend -----------------------------------------------------------------------------------
DATA_DIR=data
FRONTEND_DIST=frontend/dist
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TELEMETRY_WEBHOOK_SECRET=change-me-to-a-long-random-string
WEBHOOK_TOLERANCE_S=300
ENABLE_TELEMETRY_SIMULATOR=true
DEFAULT_SPEED_MS=450
LOG_LEVEL=INFO
