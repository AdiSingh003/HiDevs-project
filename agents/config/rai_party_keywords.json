      "action": "redact",
      "replacement": "[confidential]",
      "pattern_type": "regex"
    },
    {
      "keyword": "\\bbreak[\\s-]?even\\b",
      "action": "redact",
      "replacement": "[confidential]",
      "pattern_type": "regex"
    },
    {
      "keyword": "(lowest|least) we can (go|do|accept)",
      "action": "redact",
      "replacement": "[confidential]",
      "pattern_type": "regex"
    },
    {
      "keyword": "spot[\\s-]market (price|buyers?) (is|are|at|pay)",
